{
  "format": "world_family_group",
  "schema_version": 1,
  "visibility": "host_only",
  "family": "elastic_dynamics",
  "group_id": "elastic_dynamics_g3",
  "constants": {
    "spring_stiffness_N_m": 12.6,
    "damping_kg_s": 1.1,
    "rest_length_m": 1.3,
    "anchor_position_m": [
      -0.4,
      0.2,
      0.3
    ],
    "minimum_separation_m": 0.1
  },
  "standard_equations": {
    "restoring_force": "F_s=-k*(r-L0)*r_hat",
    "damping_force": "F_d=-c*v",
    "net_force": "F_net=F_s+F_d",
    "acceleration": "a=F_net/m"
  }
}
